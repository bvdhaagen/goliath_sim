    <!-- Publish lever + button joint angles so the status lights can react. -->
    <plugin name="switch_joint_states"
            filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/switch_wall</namespace>
      </ros>
      <update_rate>20</update_rate>
      <joint_name>revolute_3</joint_name>
      <joint_name>revolute_11</joint_name>
      <joint_name>revolute_12</joint_name>
      <joint_name>slider_32</joint_name>
      <joint_name>slider_33</joint_name>
      <joint_name>slider_34</joint_name>
