                <mesh filename="package://goliath_description/meshes/collision/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${plate_radius}" h="${plate_height}" roll="${pi/2}"/>
    </link>
    
