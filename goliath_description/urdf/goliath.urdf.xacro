    <xacro:create_link
        link_name="link_4"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        mesh_package="goliath_description"
        mesh_name="link_4"
    />

    <xacro:create_link
        link_name="link_5"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        mesh_package="goliath_description"
        mesh_name="link_5"
    />

    <xacro:create_link
        link_name="link_6"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        mesh_package="goliath_description"
        mesh_name="tool_connector"
    />

    <xacro:create_link
      link_name="tool_connector"
      xyz_offset="-0.0036 0.0053 0.0176"
      rpy_offset="0 0 0"     
      mesh_package="goliath_description"
      mesh_name="tool_base"
  />

    <!-- <link name="ft_frame"/>
    <link name="tool0"/> -->
 <!--========================================================== JOINTS ====================================================================-->
  <!-- base_joint fixes arm_base_link to the mobile base -->
    <joint name="arm_base_joint" type="fixed">
        <parent link="top_cover"/>
        <child link="arm_base_link"/>
        <origin xyz="-0.20 0.175 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- joints - main serial chain -->
    <joint name="joint_1" type="revolute">
        <parent link="arm_base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.104" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
    </joint>

    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 -0.060768 0.1694" rpy="${-pi/2} ${-pi/2} ${pi}"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="${-pi/2}" upper="${pi/2}" velocity="2.5"/>
    </joint>

    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0.315 0 -0.0198" rpy="0 ${pi} 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="${-pi/1.2}" upper="${pi/1.2}" velocity="2.5"/>
    </joint>

    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0.066258 0 0.036577" rpy="0 ${pi/2} 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
    </joint>

    <joint name="joint_5" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0.02456 0 -0.319213" rpy="0 ${pi/2} ${pi}"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="${-pi/1.5}" upper="${pi/1.5}" velocity="2.5"/>
    </joint>

    <joint name="joint_6" type="revolute">
        <parent link="link_5"/>
        <child link="link_6"/>
        <origin xyz="0.07318 0 0.02435" rpy="0 ${pi/2} 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
    </joint>

    <!-- <joint name="joint-ft_frame" type="fixed">
        <parent link="link_6"/>
        <child link="ft_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="joint-tool" type="fixed">
        <parent link="ft_frame"/>
        <child link="tool0"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint> -->
  
  
    <joint name="base_link_plate_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>
    
    <!-- <joint name="base_link_print_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="base_footprint" />
    </joint> -->
    
    <joint name="lidar_joint" type="fixed">
        <origin xyz="0.0 0.0 0.200" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>

    
    <joint name="imu_joint" type="fixed">
        <origin xyz="-0.164479 0.0 0.108" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="imu"/>
    </joint>

    <joint name="front_plate_joint" type="fixed">
        <origin xyz="0.32 0.0 0.071" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="front_plate"/>
    </joint>

    <joint name="rear_plate_joint" type="fixed">
        <origin xyz="-0.32 0.0 0.071" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rear_plate"/>
    </joint>

    <joint name="right_plate_joint" type="fixed">
        <origin xyz="0.0 -0.24 0.065" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="right_plate"/>
    </joint>

    <joint name="left_plate_joint" type="fixed">
        <origin xyz="0.0 0.24 0.065" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="left_plate"/>
    </joint>

    <joint name="top_cover_joint" type="fixed">
        <origin xyz="0.1695 -0.171 0.2165" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="top_cover"/>
    </joint>

    <joint name="unilidar_joint" type="fixed">
        <origin xyz="0.3 0 0.04" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="unilidar_imu_initial"/>
    </joint>

    <xacro:driving_wheel suffix="front_left" reflect="1" position="0.19"/>
    <xacro:driving_wheel suffix="front_right" reflect="-1" position="0.19"/>

    <xacro:driving_wheel suffix="back_left" reflect="1" position="-0.19"/>
    <xacro:driving_wheel suffix="back_right" reflect="-1" position="-0.19"/>

<!--============================================================= END-EFFECTOR =====================================================================-->

    <joint name="joint_tool_connector_frame" type="fixed">
        <parent link="link_6"/>
        <child link="tool_connector"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <joint name="joint_connector_frame" type="fixed">
        <parent link="tool_connector"/>
        <child link="tool_base"/>
        <origin xyz="-0.0038 0.005 0.017" rpy="0 0 0"/>
    </joint>

    <joint name="Rigid_20" type="fixed">
        <origin xyz="0.000365 -0.006365 0.008562" rpy="0 0 0"/>
        <parent link="tool_base"/>
        <child link="grip_mount_1"/>
    </joint>

    <joint name="slider_22" type="prismatic">
        <origin xyz="-0.022607 -0.008412 0.010565" rpy="0 0 0"/>
        <parent link="t_shirt_1"/>
        <child link="left_mount_1"/>
        <axis xyz="0.817033 -0.0 0.576591"/>
        <limit upper="0.022" lower="-0.003" effort="100" velocity="100"/>
    </joint>

    <joint name="slider_23" type="prismatic">
        <origin xyz="0.022917 -0.008412 0.010857" rpy="0 0 0"/>
        <parent link="t_shirt_1"/>
        <child link="right_mount_1"/>
        <axis xyz="0.820609 0.0 -0.57149"/>
        <limit upper="0.003" lower="-0.022" effort="100" velocity="100"/>
    </joint>

    <joint name="Rigid_24" type="fixed">
        <origin xyz="-0.01514 0.01049 0.027691" rpy="0 0 0"/>
        <parent link="left_mount_1"/>
        <child link="rubber_left_1"/>
    </joint>

    <joint name="Rigid_25" type="fixed">
        <origin xyz="0.01418 0.0105 0.028237" rpy="0 0 0"/>
        <parent link="right_mount_1"/>
        <child link="rubber_right_1"/>
    </joint>

    <joint name="Rigid_26" type="fixed">
        <origin xyz="-0.000556 -0.001302 0.013562" rpy="0 0 0"/>
        <parent link="grip_mount_1"/>
        <child link="t_shirt_1"/>
    </joint>
</robot>