        <visual name='visual'><geometry><box><size>5.0 0.2 3</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>

      <link name='hall_wall_seg3'>
        <pose>11.75 2 1.5 0 0 0</pose>
        <collision name='collision'><geometry><box><size>4.5 0.2 3</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>4.5 0.2 3</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>

      <link name='hall_wall_seg4'>
        <pose>19.0 2 1.5 0 0 0</pose>
        <collision name='collision'><geometry><box><size>8.0 0.2 3</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>8.0 0.2 3</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
